# Copy to .env and fill in.

# Claude API key: https://console.anthropic.com
ANTHROPIC_API_KEY=

# claude-opus-5-5 (default) | claude-sonnet-5-5 | claude-haiku-4-5
LLM_MODEL=claude-opus-5-5
# low | medium | high (Opus 5.5 default is medium)
LLM_EFFORT=medium

# multilingual-e5-base runs fine on CPU; use -large for better quality if you have a GPU
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Retrieval
TOP_K=5
# Cosine similarity below this means "not found in book". 0 disables the check.
MIN_SIMILARITY=0

# Protects /admin pages (username: admin)
ADMIN_PASSWORD=change-me
