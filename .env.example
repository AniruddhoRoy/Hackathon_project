# Copy to .env and fill in.

# LLM provider: ollama (Ollama Cloud) | google (Gemini API)
LLM_PROVIDER=ollama

# Ollama Cloud key: https://ollama.com/settings/keys
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b

# Google AI Studio key (Gemini API), used when LLM_PROVIDER=google: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# gemma-4-26b-a4b-it (fast) | gemma-4-31b-it (larger)
GOOGLE_MODEL=gemma-4-26b-a4b-it

# multilingual-e5-base runs fine on CPU; use -large for better quality if you have a GPU
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Retrieval
TOP_K=5
# Cosine similarity below this means "not found in book". 0 disables the check.
MIN_SIMILARITY=0

# Protects /admin pages (username: admin)
ADMIN_PASSWORD=change-me
